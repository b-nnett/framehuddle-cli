{
  "name": "framehuddle",
  "version": "0.1.0",
  "description": "Framehuddle projects, screenshot exports, and feedback from the terminal",
  "type": "module",
  "bin": {
    "framehuddle": "dist/index.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "THIRD_PARTY_LICENSES"
  ],
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "tsx src/index.ts",
    "build": "node build.mjs",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test tests/*.test.*",
    "check": "npm run typecheck && npm test && npm run build && node scripts/smoke.mjs",
    "prepack": "npm run build",
    "release": "node scripts/release.mjs"
  },
  "devDependencies": {
    "esbuild": "^0.28.2",
    "tsx": "^4.23.13",
    "typescript": "^7.0.2",
    "@types/node": "^26.4.1",
    "zod": "^4.5.4"
  },
  "license": "MIT",
  "homepage": "https://framehuddle.com",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/b-nnett/framehuddle-cli.git"
  },
  "bugs": {
    "url": "https://github.com/b-nnett/framehuddle-cli/issues"
  }
}
